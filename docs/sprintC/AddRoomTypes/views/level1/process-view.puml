@startuml AddRoomType(level1)

actor Admin as "Admin"
participant SYS as "HealthCare System" <<system (C4)>>

activate Admin 

Admin -> SYS : asks to add a new room type 

activate SYS 
SYS --> Admin : displays the form for adding new room type
deactivate SYS

Admin -> SYS : submits the form with room type data
activate SYS
SYS --> Admin : displays confirmation message that the room type was added

deactivate SYS

@enduml
