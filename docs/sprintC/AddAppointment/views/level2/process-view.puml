@startuml AddAppointment(level2)
autonumber

actor "Doctor" as Doctor
participant Frontend as "Frontend" <<system (C4)>>
participant Backend as "BackendManagement" <<system (C4)>>

activate Doctor
    Doctor -> Frontend : asks to add a new appointment
    activate Frontend
        Frontend --> Doctor : asks to insert the details of the appointment
    
    deactivate Frontend
    Doctor -> Frontend : inserts the details
    activate Frontend
    
        Frontend-> Backend : POST /appointments
        activate Backend
            Frontend <-- Backend : 200 OK
        deactivate Backend
    Frontend --> Doctor : displays confirmation message that the appointment was added
    
    deactivate Frontend
    deactivate Doctor
@enduml